# Runtime contract: development | test | production
APP_ENV="development"

# Public origin of this application
APP_URL="http://localhost:3000"

# Local SQLite database. Production requires a separate database migration.
DATABASE_URL="file:./dev.db"

# Development-only value. Generate a production secret with:
# openssl rand -base64 32
BETTER_AUTH_SECRET="ignite-development-only-secret-change-before-deploying"

# The template uses self-contained email/password auth. No mail provider is required.
